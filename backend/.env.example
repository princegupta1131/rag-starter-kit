# ─── REQUIRED ─────────────────────────────────────────────────────────────
# Any Postgres with the pgvector extension (local, Supabase, Neon, RDS...)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rag_starter

# Which AI to use: gemini (default) or openai
LLM_PROVIDER=gemini

# Gemini key. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ─── OR USE OPENAI ────────────────────────────────────────────────────────
# Set LLM_PROVIDER=openai above, then add your key here:
# OPENAI_API_KEY=your-openai-api-key
# Changing provider changes the embedding model: upload documents again afterwards.

# ─── OPTIONAL (defaults shown) ────────────────────────────────────────────
# CHAT_MODEL=                   # empty = provider default (gemini-3.5-flash-lite / gpt-6-luna)
# EMBED_MODEL=                  # empty = provider default (gemini-embedding-001 / text-embedding-3-small)
# EMBED_DIM=768                 # fixed once the tables exist

# Ingestion
# CHUNK_SIZE_WORDS=200
# CHUNK_OVERLAP_WORDS=40
# MAX_UPLOAD_MB=20
# MAX_VIDEO_MB=200   (videos need LLM_PROVIDER=gemini)

# Retrieval
# TOP_K=6                       # chunks considered for the answer
# CANDIDATES_PER_SEARCH=20
# MIN_SIMILARITY=0.50           # below this: "not found"
# CONTEXT_MARGIN=0.12          # chunks this far below the best match are left out of the answer
# QUERY_REWRITE=true
# STRICT_CITATIONS=true
# CACHE_TTL_SECONDS=600
# TEXT_SEARCH_LANGUAGE=english  # "simple" for mixed-language content (set before first start)

# Server
# CORS_ORIGINS=http://localhost:5173
# LOG_LEVEL=INFO
# DB_POOL_MAX=10

# Tests only: a database that `make test` may WIPE (its name must contain "test")
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rag_starter_test
