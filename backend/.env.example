# ─── REQUIRED: the only two things you must set ───────────────────────────
# Any Postgres with the pgvector extension (local, Supabase, Neon, RDS...)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rag_starter

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ─── OPTIONAL: tune during the hands-on (defaults shown) ──────────────────
# CHAT_MODEL=gemini-3.5-flash-lite
# VISION_MODEL=gemini-3.5-flash-lite
# EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=768                 # fixed once tables exist; drop tables to change

# Ingestion
# CHUNK_SIZE_WORDS=200
# CHUNK_OVERLAP_WORDS=40
# MAX_UPLOAD_MB=20

# Retrieval
# TOP_K=6
# CANDIDATES_PER_SEARCH=20
# MIN_SIMILARITY=0.50           # evidence gate
# QUERY_REWRITE=true
# STRICT_CITATIONS=true
# CACHE_TTL_SECONDS=600
# TEXT_SEARCH_LANGUAGE=english  # use "simple" for mixed-language content (set before first start)

# CORS_ORIGINS=http://localhost:5173
